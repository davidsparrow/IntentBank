# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used solely for account deletion (auth.admin.deleteUser).
SUPABASE_SECRET_KEY=

# Server-only. Used by the intent engine for signal clustering.
ANTHROPIC_API_KEY=

# CLI only (npm run db:push / db:types). Dashboard → Connect → Session pooler (port 5432).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres
